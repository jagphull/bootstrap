{
  "manifest_version": 3,
  "name": "Dealer Inventory Scraper",
  "short_name": "Inventory Scraper",
  "version": "0.1.0",
  "description": "Capture vehicle listing fields and photos from dealership websites into a Google Sheet, with images stored in Google Drive.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
